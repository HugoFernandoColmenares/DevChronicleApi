# Token del autor. Obligatorio para arrancar el API. No lo subas a git.
AUTHOR_TOKEN=

# Archivo SQLite. El proceso crea el directorio y el archivo si no existen.
DATABASE_URL=sqlite://./data/devchronicle.db?mode=rwc

# Dirección de escucha. En Docker Compose el plan usa 0.0.0.0:8080.
BIND=127.0.0.1:8080

# Carpeta con index.json y los Markdown. Si se omite, seed busca el contenido del frontend.
CONTENT_DIR=../frontend/public/content
